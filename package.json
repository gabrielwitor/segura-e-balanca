{
  "name": "segura-e-balanca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode emulador",
    "dev:dev": "vite --mode dev",
    "emuladores": "firebase emulators:start --only firestore,auth --project demo-seb",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run --project unit",
    "test:rules": "vitest run --project rules",
    "test:e2e": "playwright test",
    "test:e2e:local": "vite build --mode emulador && firebase emulators:exec --only firestore,auth --project demo-seb \"playwright test --project=pixel-7\"",
    "verificar:pr": "eslint . && tsc -b --noEmit && vitest run --project unit && firebase emulators:exec --only firestore --project demo-seb \"vitest run --project rules\" && npm run test:e2e:local",
    "test": "vitest run --project unit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "firebase": "^12.19.0",
    "leaflet": "1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "react-simple-pull-to-refresh": "^1.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^14.27.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
